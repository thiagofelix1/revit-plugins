<Window x:Class="Eletrica.AddIn.Fiacao.FiacaoManualJanela"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoEletrica — Fiação manual" Width="760" Height="560" MinWidth="600" MinHeight="380"
        WindowStartupLocation="CenterScreen" FontSize="13" Background="White">
    <DockPanel Margin="16">
        <TextBlock x:Name="Cabecalho" DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#37474F" Margin="0,0,0,12"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <CheckBox x:Name="EvitarTodos" Content="Evitar todos os outros circuitos nestes eletrodutos" VerticalAlignment="Center" Margin="0,0,24,0"/>
            <Button Content="Cancelar" Width="100" Height="30" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Aplicar" Width="100" Height="30" IsDefault="True" FontWeight="Bold" Click="Aplicar_Click"/>
        </StackPanel>
        <DataGrid x:Name="Grade" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" RowHeight="28" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Circuito" Binding="{Binding Numero}" IsReadOnly="True" Width="80"/>
                <DataGridTextColumn Header="Quadro" Binding="{Binding Quadro}" IsReadOnly="True" Width="110"/>
                <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="Hoje" Binding="{Binding Hoje}" IsReadOnly="True" Width="90"/>
                <DataGridComboBoxColumn x:Name="ColunaModo" Header="Nestes eletrodutos" SelectedItemBinding="{Binding Modo, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
