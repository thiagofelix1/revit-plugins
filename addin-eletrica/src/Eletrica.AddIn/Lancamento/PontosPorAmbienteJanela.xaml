<Window x:Class="Eletrica.AddIn.Lancamento.PontosPorAmbienteJanela"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoEletrica — Pontos por ambiente" Width="1000" Height="620" MinWidth="800" MinHeight="420"
        WindowStartupLocation="CenterScreen" FontSize="13" Background="White">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#37474F" Margin="0,0,0,12"
                   Text="O que a NBR 5410 9.5.2 pede em cada ambiente (tomadas pelo perímetro e uso, 600 VA nos três primeiros pontos de área molhada, ponto de luz no teto com a carga mínima) e o que o padrão sugere (chuveiro, ar-condicionado). Ajuste as quantidades, marque os ambientes e lance: tomadas distribuídas pelas paredes, luz no centro, interruptor junto da porta já comandando a luz, chuveiro e ar na parede oposta à porta. Depois mova o que quiser na mão e rode Criar circuitos."/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="Rodape" VerticalAlignment="Center" Foreground="#6B6B6B" Margin="0,0,16,0"/>
            <Button Content="Cancelar" Width="100" Height="30" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Lançar" Width="100" Height="30" IsDefault="True" FontWeight="Bold" Click="Lancar_Click"/>
        </StackPanel>
        <DataGrid x:Name="Grade" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" RowHeight="28" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Lançar" Binding="{Binding Lancar, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                <DataGridTextColumn Header="Ambiente" Binding="{Binding Nome}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="Uso" Binding="{Binding Uso}" IsReadOnly="True" Width="110"/>
                <DataGridTextColumn Header="Área" Binding="{Binding Area, StringFormat=N1}" IsReadOnly="True" Width="55"/>
                <DataGridTextColumn Header="Perím." Binding="{Binding Perimetro, StringFormat=N1}" IsReadOnly="True" Width="55"/>
                <DataGridTextColumn Header="Tomadas" Binding="{Binding Tomadas, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                <DataGridTextColumn Header="de 600 VA" Binding="{Binding Tomadas600, UpdateSourceTrigger=PropertyChanged}" Width="75"/>
                <DataGridTextColumn Header="na média" Binding="{Binding TomadasMedia, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                <DataGridTextColumn Header="Luz (VA)" Binding="{Binding LuzVA, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                <DataGridCheckBoxColumn Header="Interruptor" Binding="{Binding Interruptor, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                <DataGridCheckBoxColumn Header="Chuveiro" Binding="{Binding Chuveiro, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                <DataGridCheckBoxColumn Header="Ar-cond." Binding="{Binding Ar, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                <DataGridTextColumn Header="Já tem" Binding="{Binding Existentes}" IsReadOnly="True" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
