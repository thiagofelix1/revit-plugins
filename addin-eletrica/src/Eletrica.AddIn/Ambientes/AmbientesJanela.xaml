<Window x:Class="Eletrica.AddIn.Ambientes.AmbientesJanela"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoEletrica — Ambientes" Width="880" Height="600" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterScreen" FontSize="13" Background="White">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#37474F" Margin="0,0,0,12"
                   Text="Uso de cada ambiente, sugerido pelo nome. O uso define os pontos mínimos de tomada e de luz (9.5.2), a potência das tomadas e onde o DR de 30 mA é obrigatório (5.1.3.2.2). Corrija na coluna Uso e confirme."/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancelar" Width="100" Height="30" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Confirmar" Width="100" Height="30" IsDefault="True" FontWeight="Bold" Click="Confirmar_Click"/>
        </StackPanel>
        <DataGrid x:Name="Grade" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" RowHeight="28" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nº" Binding="{Binding Numero}" IsReadOnly="True" Width="60"/>
                <DataGridTextColumn Header="Ambiente" Binding="{Binding Nome}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="Nível" Binding="{Binding Nivel}" IsReadOnly="True" Width="110"/>
                <DataGridTextColumn Header="Origem" Binding="{Binding Origem}" IsReadOnly="True" Width="130"/>
                <DataGridTextColumn Header="Área (m²)" Binding="{Binding Area, StringFormat=N1}" IsReadOnly="True" Width="80"/>
                <DataGridTextColumn Header="Perímetro (m)" Binding="{Binding Perimetro, StringFormat=N1}" IsReadOnly="True" Width="100"/>
                <DataGridComboBoxColumn x:Name="ColunaUso" Header="Uso" SelectedItemBinding="{Binding UsoTexto, UpdateSourceTrigger=PropertyChanged}" Width="170"/>
                <DataGridTextColumn Header="" Binding="{Binding Situacao}" IsReadOnly="True" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
