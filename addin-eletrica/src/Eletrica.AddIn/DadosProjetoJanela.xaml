<Window x:Class="Eletrica.AddIn.DadosProjetoJanela"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoEletrica — Dados do projeto" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" FontSize="13">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Width="100" Height="30" Margin="0,0,8,0" IsCancel="True" Click="Cancelar_Click"/>
            <Button Content="Confirmar" Width="100" Height="30" IsDefault="True" FontWeight="Bold" Click="Confirmar_Click"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#37474F"
                   Text="Dados da alimentação (NBR 5410 4.2.2, 4.2.3, 4.2.6 e 5.4.2.1). O plugin não deduz tensão, esquema nem corrente de curto: o cálculo usa o que estiver confirmado aqui, e isso vai para o memorial."/>
        <StackPanel>
            <GroupBox Header="Alimentação" Padding="8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="240"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Sistema (fase-neutro / fase-fase)" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox x:Name="Sistema" Grid.Column="1" Margin="0,4"/>
                    <TextBlock Grid.Row="1" Text="Número de fases na entrada" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox x:Name="Fases" Grid.Row="1" Grid.Column="1" Margin="0,4"/>
                    <TextBlock Grid.Row="2" Text="Esquema de aterramento" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox x:Name="Esquema" Grid.Row="2" Grid.Column="1" Margin="0,4"/>
                    <TextBlock Grid.Row="3" Text="Icc presumida no ponto de entrega (kA)" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox x:Name="Icc" Grid.Row="3" Grid.Column="1" Margin="0,4" Padding="4"/>
                </Grid>
            </GroupBox>
            <GroupBox Header="Sobretensões e local" Padding="8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="240"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <CheckBox x:Name="Aerea" Grid.ColumnSpan="2" Content="Alimentação por linha aérea (total ou em parte)" Margin="0,4"/>
                    <TextBlock Grid.Row="1" Text="Dias de trovoada por ano (AQ2 acima de 25)" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox x:Name="Trovoadas" Grid.Row="1" Grid.Column="1" Margin="0,4" Padding="4"/>
                    <CheckBox x:Name="Spda" Grid.Row="2" Grid.ColumnSpan="2" Content="Estrutura com SPDA ou exposta a descarga direta (AQ3)" Margin="0,4"/>
                    <TextBlock Grid.Row="3" Text="Temperatura ambiente de projeto (°C)" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox x:Name="Temperatura" Grid.Row="3" Grid.Column="1" Margin="0,4" Padding="4"/>
                    <CheckBox x:Name="Habitacao" Grid.Row="4" Grid.ColumnSpan="2" Content="Edificação residencial (valem as regras da seção 9.5)" Margin="0,4"/>
                </Grid>
            </GroupBox>
            <TextBlock TextWrapping="Wrap" Foreground="#6B6B6B" FontSize="12"
                       Text="Sem a Icc presumida os critérios de curto-circuito (capacidade de interrupção, I²t e Zs·Ia) ficam como não avaliados no memorial. Peça o valor à distribuidora ou calcule pelo transformador."/>
        </StackPanel>
    </DockPanel>
</Window>
