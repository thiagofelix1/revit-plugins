<Window x:Class="Eletrica.AddIn.Verificacao.VerificacaoJanela"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoEletrica — Verificar modelo" Width="900" Height="640" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen" FontSize="13" Background="White">
    <DockPanel Margin="16">
        <TextBlock x:Name="Resumo" DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold" Foreground="#263238" Margin="0,0,0,4"/>
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#607D8B" Margin="0,0,0,12"
                   Text="Cada linha cita o item da NBR 5410. Escolha uma e clique em Mostrar: a janela fecha, os elementos ficam selecionados e a vista vai até eles. Depois de corrigir, rode Verificar de novo."/>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Left" Content="Copiar relatório" Padding="12,4" Click="Copiar_Click"/>
            <Button DockPanel.Dock="Left" Content="Salvar relatório" Padding="12,4" Margin="8,0,0,0" Click="Salvar_Click"/>
            <ComboBox x:Name="Filtro" DockPanel.Dock="Left" Width="150" Margin="16,0,0,0" VerticalAlignment="Center" SelectionChanged="Filtro_SelectionChanged"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BotaoMostrar" Content="Mostrar" Width="100" Padding="12,4" Margin="0,0,8,0" FontWeight="Bold" Click="Mostrar_Click"/>
                <Button Content="Fechar" Width="100" Padding="12,4" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
        <ListView x:Name="Lista" MouseDoubleClick="Lista_MouseDoubleClick" SelectionChanged="Lista_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,3" MaxWidth="820">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{Binding Cor}" CornerRadius="3" Padding="6,1" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Etiqueta}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="{Binding Codigo}" FontWeight="SemiBold" Margin="0,0,8,0" Foreground="#455A64"/>
                            <TextBlock Text="{Binding Item}" Foreground="#78909C"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </DockPanel>
</Window>
