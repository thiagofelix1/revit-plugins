<Window x:Class="Eletrica.AddIn.Familias.FamiliasJanela"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoEletrica — Famílias do escritório" Width="980" Height="620" MinWidth="760" MinHeight="400"
        WindowStartupLocation="CenterScreen" FontSize="13" Background="White">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#37474F" Margin="0,0,0,12"
                   Text="Tipos de família carregados nas categorias elétricas, com o papel sugerido pelo nome. O papel diz ao plugin o que cada família é (tomada de 10 A, luminária, interruptor paralelo, quadro...): é por ele que Inserir ponto, Pontos por ambiente e Criar circuitos escolhem a família e preenchem potência, altura e tipo de carga. Famílias sem conector elétrico não entram em circuito do Revit."/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancelar" Width="100" Height="30" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Confirmar" Width="100" Height="30" IsDefault="True" FontWeight="Bold" Click="Confirmar_Click"/>
        </StackPanel>
        <DataGrid x:Name="Grade" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" RowHeight="28" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" IsReadOnly="True" Width="150"/>
                <DataGridTextColumn Header="Família" Binding="{Binding Familia}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" IsReadOnly="True" Width="160"/>
                <DataGridTextColumn Header="Instâncias" Binding="{Binding Instancias}" IsReadOnly="True" Width="80"/>
                <DataGridTextColumn Header="Hospedagem" Binding="{Binding Hospedagem}" IsReadOnly="True" Width="90"/>
                <DataGridTextColumn Header="Conector" Binding="{Binding Conector}" IsReadOnly="True" Width="70"/>
                <DataGridComboBoxColumn x:Name="ColunaPapel" Header="Papel" SelectedItemBinding="{Binding PapelTexto, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
