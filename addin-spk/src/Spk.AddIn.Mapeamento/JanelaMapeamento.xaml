<Window x:Class="Spk.AddIn.Mapeamento.JanelaMapeamento"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Spk.AddIn.Mapeamento"
        Title="Spk — Confirmar famílias identificadas" Height="480" Width="1180"
        WindowStartupLocation="CenterOwner" FontSize="13">
    <Window.Resources>
        <Style x:Key="Info" TargetType="Border">
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#E3F2FD"/>
            <Setter Property="Cursor" Value="Help"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancelar" Width="100" Height="30" Margin="0,0,10,0" Click="Cancelar_Click"/>
            <Button Content="Confirmar" Width="100" Height="30" Click="Confirmar_Click" IsDefault="True" FontWeight="Bold"/>
        </StackPanel>

        <Border DockPanel.Dock="Top" Background="#EEF4FB" BorderBrush="#C7DCF0" BorderThickness="1" Padding="8" Margin="0,0,0,10">
            <TextBlock TextWrapping="Wrap">
                O Spk identificou estas combinações de categoria + família + tipo e preencheu o fator K e a área quando achou um parâmetro.
                <Bold>Verde</Bold> = chuveiro, <Bold>azul</Bold> = fonte/VGA, <Bold>cinza</Bold> = ignorado.
                Os números continuam editáveis mesmo quando preenchidos. Passe o mouse no <Bold>i</Bold> ao lado do título para ver a unidade e o que o campo significa.
            </TextBlock>
        </Border>

        <DataGrid x:Name="Grade" AutoGenerateColumns="False" CanUserAddRows="False"
                  RowHeight="36" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E0E0E0" BorderBrush="#CCCCCC" BorderThickness="1">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#37474F"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="6,4"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Papel}" Value="{x:Static local:PapelFamilia.Chuveiro}">
                            <Setter Property="Background" Value="#E6F4EA"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Papel}" Value="{x:Static local:PapelFamilia.Fonte}">
                            <Setter Property="Background" Value="#E3F0FB"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Papel}" Value="{x:Static local:PapelFamilia.Ignorar}">
                            <Setter Property="Background" Value="#F2F2F2"/>
                            <Setter Property="Foreground" Value="#8A8A8A"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" IsReadOnly="True" Width="150"/>
                <DataGridTextColumn Header="Família" Binding="{Binding Familia}" IsReadOnly="True" Width="170"/>
                <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" IsReadOnly="True" Width="100"/>
                <DataGridTextColumn Header="Qtd" Binding="{Binding QuantidadeInstancias}" IsReadOnly="True" Width="40"/>
                <DataGridComboBoxColumn x:Name="ColunaPapel" SelectedItemBinding="{Binding Papel}" Width="118">
                    <DataGridComboBoxColumn.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Papel" VerticalAlignment="Center"/>
                            <Border Margin="6,0,0,0" Style="{StaticResource Info}">
                                <Border.ToolTip>
                                    <ToolTip MaxWidth="300">
                                        <TextBlock TextWrapping="Wrap" Text="Chuveiro entra no cálculo. Fonte/VGA é o ponto onde a demanda do setor é calculada. Ignorar deixa a família de fora, como uma anotação de prancha."/>
                                    </ToolTip>
                                </Border.ToolTip>
                                <TextBlock Text="i" FontSize="11" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                            </Border>
                        </StackPanel>
                    </DataGridComboBoxColumn.Header>
                </DataGridComboBoxColumn>
                <DataGridTemplateColumn Width="230">
                    <DataGridTemplateColumn.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Fator K" VerticalAlignment="Center"/>
                            <Border Margin="6,0,0,0" Style="{StaticResource Info}">
                                <Border.ToolTip>
                                    <ToolTip MaxWidth="320">
                                        <TextBlock TextWrapping="Wrap" Text="Coeficiente do bico na fórmula Q = K√P. A unidade desta coluna é L/min/bar½, a da NBR. O valor vale para todas as instâncias deste tipo. Se o plugin achou um parâmetro, o número vem preenchido e continua editável. K americano comum, para converter: 5,6 → 80; 8,0 → 115; 11,2 → 160; 14,0 → 200; 25,2 → 360."/>
                                    </ToolTip>
                                </Border.ToolTip>
                                <TextBlock Text="i" FontSize="11" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                            </Border>
                        </StackPanel>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DockPanel Margin="3,0" LastChildFill="True" ToolTip="{Binding OrigemFatorK}">
                                <TextBlock DockPanel.Dock="Right" Text="L/min/bar½" VerticalAlignment="Center" Margin="6,0,2,0" Foreground="#455A64"/>
                                <TextBox Text="{Binding ValorFatorK, UpdateSourceTrigger=PropertyChanged}"
                                         Background="White" BorderBrush="#B0BEC5" Padding="4,2" VerticalContentAlignment="Center"/>
                            </DockPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="210">
                    <DataGridTemplateColumn.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Área de cobertura" VerticalAlignment="Center"/>
                            <Border Margin="6,0,0,0" Style="{StaticResource Info}">
                                <Border.ToolTip>
                                    <ToolTip MaxWidth="320">
                                        <TextBlock TextWrapping="Wrap" Text="Área que cada bico deste tipo precisa atender, em m². Entra na vazão mínima (densidade × área). O número sugerido pode vir de um parâmetro genérico chamado Área; confira se é a área de cobertura. Continua editável mesmo quando preenchido."/>
                                    </ToolTip>
                                </Border.ToolTip>
                                <TextBlock Text="i" FontSize="11" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                            </Border>
                        </StackPanel>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DockPanel Margin="3,0" LastChildFill="True" ToolTip="{Binding OrigemAreaCobertura}">
                                <TextBlock DockPanel.Dock="Right" Text="m²" VerticalAlignment="Center" Margin="6,0,2,0" Foreground="#455A64"/>
                                <TextBox Text="{Binding ValorAreaCobertura, UpdateSourceTrigger=PropertyChanged}"
                                         Background="White" BorderBrush="#B0BEC5" Padding="4,2" VerticalContentAlignment="Center"/>
                            </DockPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Parâmetros disponíveis (referência)" Binding="{Binding ParametrosTexto}" IsReadOnly="True" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
