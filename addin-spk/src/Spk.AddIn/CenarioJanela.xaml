<Window x:Class="Spk.AddIn.CenarioJanela"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPK — Rede de exemplo" Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" FontSize="13">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <CheckBox x:Name="Criterios" IsChecked="True" Margin="0,0,0,12"
                      Content="Gravar também os critérios de projeto do cenário (classe de risco e base de cálculo)"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Width="100" Height="30" Margin="0,0,8,0" IsCancel="True" Click="Cancelar_Click"/>
                <Button Content="Gerar" Width="100" Height="30" IsDefault="True" FontWeight="Bold" Click="Gerar_Click"/>
            </StackPanel>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#37474F"
                   Text="Escolha a rede de teste. A malha gerada anterior é apagada. Use um projeto com tipo de tubo que tenha tê nas preferências de roteamento."/>
        <ListBox x:Name="Lista" Height="330" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="Lista_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,6">
                        <TextBlock FontWeight="Bold" Text="{Binding Titulo}"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#546E7A" Text="{Binding Descricao}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
