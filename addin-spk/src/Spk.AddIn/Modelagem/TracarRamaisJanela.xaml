<Window x:Class="Spk.AddIn.Modelagem.TracarRamaisJanela"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPK — Traçar ramais" SizeToContent="Height" Width="500"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" FontSize="13">
    <StackPanel Margin="16">
        <TextBlock x:Name="Resumo" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#37474F"/>

        <GroupBox Header="Altura do ramal" Padding="8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <RadioButton x:Name="NaSubgeral" GroupName="Altura" Margin="0,4" VerticalContentAlignment="Center"
                             Content="Na altura da subgeral (tê; cruzeta com bicos dos dois lados)"/>
                <RadioButton x:Name="RelativaASubgeral" Grid.Row="1" GroupName="Altura" Margin="0,4" VerticalContentAlignment="Center"
                             Content="Acima da subgeral, com subida (m; negativo: abaixo)"/>
                <TextBox x:Name="AcimaDaSubgeral" Grid.Row="1" Grid.Column="1" Margin="0,4" Padding="4"/>
                <RadioButton x:Name="RelativaAoPiso" Grid.Row="2" GroupName="Altura" Margin="0,4" VerticalContentAlignment="Center"
                             Content="Altura fixa acima do nível da subgeral (m)"/>
                <TextBox x:Name="AcimaDoPiso" Grid.Row="2" Grid.Column="1" Margin="0,4" Padding="4"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="Fileiras" Padding="8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"
                           Text="Bicos a até esta distância um do outro, medida ao longo da subgeral, ficam no mesmo ramal (m)"/>
                <TextBox x:Name="Tolerancia" Grid.Column="1" Padding="4" VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>

        <CheckBox x:Name="Ligar" Margin="0,0,0,4" Content="Ligar os bicos aos ramais (descida, braço, ou subida do bico em pé)"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Width="100" Height="30" Margin="0,0,8,0" IsCancel="True" Click="Cancelar_Click"/>
            <Button Content="Traçar" Width="100" Height="30" IsDefault="True" FontWeight="Bold" Click="Tracar_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
