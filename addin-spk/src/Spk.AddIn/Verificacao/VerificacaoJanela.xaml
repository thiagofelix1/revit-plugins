<Window x:Class="Spk.AddIn.Verificacao.VerificacaoJanela"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPK — Verificar modelo" Width="860" Height="640" MinWidth="620" MinHeight="400"
        WindowStartupLocation="CenterScreen" FontSize="13" Background="White">
    <DockPanel Margin="16">
        <TextBlock x:Name="Resumo" DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold" Foreground="#263238" Margin="0,0,0,4"/>
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#607D8B" Margin="0,0,0,12"
                   Text="Escolha um item e clique em Mostrar: a janela fecha, os elementos ficam selecionados e a vista vai até eles. Depois de corrigir, rode Verificar de novo."/>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Left" Content="Copiar relatório" Padding="12,4" Click="Copiar_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BotaoTodos" Content="Selecionar todos do grupo" Padding="12,4" Margin="0,0,8,0" Click="Todos_Click"/>
                <Button x:Name="BotaoMostrar" Content="Mostrar" Width="100" Padding="12,4" Margin="0,0,8,0" FontWeight="Bold" Click="Mostrar_Click"/>
                <Button Content="Fechar" Width="100" Padding="12,4" IsCancel="True" Click="Fechar_Click"/>
            </StackPanel>
        </DockPanel>
        <TreeView x:Name="Arvore" SelectedItemChanged="Arvore_SelectedItemChanged" MouseDoubleClick="Arvore_MouseDoubleClick">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Filhos}">
                    <StackPanel Margin="0,3">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{Binding Cor}" CornerRadius="3" Padding="6,1" Margin="0,0,8,0" Visibility="{Binding EtiquetaVisivel}">
                                <TextBlock Text="{Binding Etiqueta}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="{Binding Texto}" FontWeight="{Binding Peso}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Detalhe}" TextWrapping="Wrap" MaxWidth="740" Foreground="#607D8B" Margin="0,2,0,0" Visibility="{Binding DetalheVisivel}"/>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </DockPanel>
</Window>
