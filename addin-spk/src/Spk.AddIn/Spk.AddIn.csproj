<Project Sdk="Nice3point.Revit.Sdk/6.3.2">

    <PropertyGroup>
        <!-- Sem deploy automático: builds feitos de dentro de apps empacotados (MSIX, ex.: Claude Desktop) têm a
             gravação em %AppData% redirecionada para uma pasta privada que o Revit não enxerga, e o Revit 2027 não
             aceita mais ProgramData. Em desenvolvimento, um manifesto em %AppData% aponta para bin\...\publish. -->
        <DeployAddin>false</DeployAddin>
        <PublishAddin>true</PublishAddin>
        <LaunchRevit>true</LaunchRevit>
        <IsRepackable>false</IsRepackable>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <UseWPF>true</UseWPF>
        <!-- A UI de confirmação de mapeamento usa WPF/.NET 8+: 2023/2024 (net48) ficam fora até precisarmos, conforme docs/api/02-versoes.md. -->
        <Configurations>Debug.R25;Debug.R26;Debug.R27</Configurations>
        <Configurations>$(Configurations);Release.R25;Release.R26;Release.R27</Configurations>
    </PropertyGroup>

    <ItemGroup>
        <!-- Capítulos do Guia do SPK, lidos por Ajuda\TextoDoGuia.cs. -->
        <EmbeddedResource Include="Ajuda\*.md"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\motor-spk\src\Spk.Motor\Spk.Motor.csproj"/>
        <ProjectReference Include="..\Spk.AddIn.Mapeamento\Spk.AddIn.Mapeamento.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Revit Dependencies -->
        <PackageReference Include="Nice3point.Revit.Toolkit" Version="$(RevitVersion).*"/>
        <PackageReference Include="Nice3point.Revit.Extensions" Version="$(RevitVersion).*"/>
        <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*"/>
        <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*"/>
        <PackageReference Include="Nice3point.Revit.Api.AdWindows" Version="$(RevitVersion).*"/>

        <!-- Development Dependencies -->
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="all"/>
        <PackageReference Include="Polyfill" Version="11.4.3" PrivateAssets="all"/>
    </ItemGroup>

</Project>
